# === Production Environment ===
# Configure these variables in your PaaS dashboard (e.g., Render, Heroku, AWS)

# Database connection string (provided by PaaS PostgreSQL add-on)
# Format: postgresql://user:password@host:port/dbname?schema=public
# Example (Render): postgresql://taskmanager_prod_user:xxxxx@dpg-xxxxx.postgres.render.com:5432/taskmanager_prod?schema=public
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# JWT secret key (MUST be at least 32 characters, use a strong random value)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-strong-random-secret-key-minimum-32-characters-xxxxxxxxxxxxxxxx"

# Server port (usually assigned by PaaS; only override if needed)
PORT=3333

# Production environment flag (do NOT change)
NODE_ENV="production"

# Notes:
# - DATABASE_URL is typically auto-provided by PaaS PostgreSQL add-on
# - Set JWT_SECRET to a strong random value (use crypto-secure generation)
# - Migrations are applied automatically on app startup
