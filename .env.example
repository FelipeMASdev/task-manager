# === Development/Local Environment ===
# For local development (app running outside Docker)
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/<DB_NAME>?schema=public"

# For development with Docker Compose (app and database in containers)
DATABASE_URL_DOCKER="postgresql://<DB_USER>:<DB_PASSWORD>@postgres:5432/<DB_NAME>?schema=public"

POSTGRES_USER="<DB_USER>"
POSTGRES_PASSWORD="<DB_PASSWORD>"
POSTGRES_DB="<DB_NAME>"

# Application settings
JWT_SECRET="your-secret-key-min-32-chars-for-dev-xxxxxxxx"
PORT=3333
NODE_ENV="development"

# Test seed user credentials (used by integration tests)
ADMIN_USER="admin@taskmanager.com"
ADMIN_PASSWORD="123456"

MEMBER_USER="joao@taskmanager.com"
MEMBER_PASSWORD="123456"